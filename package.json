{
  "name": "wansan-studio",
  "version": "0.7.2",
  "description": "本地优先的智能商业报表桌面端软件 - Local-First Business Intelligence Desktop App",
  "main": "dist/main/index.js",
  "homepage": "https://studio.wansan.app",
  "author": {
    "name": "Wansan Studio",
    "email": "jin4074@gmail.com"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NO_OBFUSCATION=true npm run build:main && npm run build:export && concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "build": "rimraf dist && npm run build:renderer && npm run build:main && npm run build:export",
    "build:renderer": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vite build",
    "build:main": "tsup",
    "dist": "rimraf dist_electron && npm run build && electron-builder --config electron-builder.yml",
    "dist:mac": "rimraf dist_electron && npm run build && electron-builder --config electron-builder.yml --mac",
    "dist:mac:x64": "rimraf dist_electron && npm run build && electron-builder --config electron-builder.yml --mac --x64",
    "dist:mac:all": "rimraf dist_electron && npm run build && electron-builder --config electron-builder.yml --mac --x64 --arm64",
    "dist:win": "rimraf dist_electron && npm run build && electron-builder --config electron-builder.yml --win",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "lint:slim": "eslint src --ext .ts,.tsx --rule '{\"@typescript-eslint/no-explicit-any\": \"off\"}'",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "type-check": "npm run lint:slim && tsc --noEmit",
    "test": "cross-env NODE_ENV=development vitest --run",
    "build:export": "vite build --config vite.export.config.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.4.3-r.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@tanstack/react-virtual": "^3.13.18",
    "date-fns": "^4.1.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.1.7",
    "exceljs": "^4.4.0",
    "fs-extra": "^11.3.2",
    "iconv-lite": "^0.7.2",
    "lodash.debounce": "^4.0.8",
    "mysql2": "^3.16.1",
    "node-machine-id": "^1.1.12",
    "openai": "^6.10.0",
    "pg": "^8.17.2",
    "pg-query-stream": "^4.11.2",
    "react-day-picker": "^9.13.2",
    "uuid": "^9.0.1",
    "zod": "^4.3.4"
  },
